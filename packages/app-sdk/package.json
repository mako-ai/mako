{
  "name": "@makoai/app-sdk",
  "version": "2.20.0",
  "description": "Mako app SDK: data bindings (useQuery/useDuckDB), URL state, theme, and the house dashboard kit (/ui).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mako-ai/mako.git",
    "directory": "packages/app-sdk"
  },
  "homepage": "https://docs.mako.ai/mcp-server/",
  "keywords": [
    "mako",
    "data-apps",
    "duckdb",
    "parquet",
    "vite-plugin"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./credentials": {
      "types": "./credentials.d.ts",
      "default": "./credentials.js"
    },
    "./ui": {
      "types": "./ui.d.ts",
      "default": "./ui.js"
    },
    "./menu": {
      "types": "./menu/index.ts",
      "default": "./menu/index.ts"
    },
    "./ui.css": "./ui.css"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "progress.js",
    "data-core.js",
    "vite.js",
    "vite.d.ts",
    "credentials.js",
    "credentials.d.ts",
    "ui.js",
    "ui-core.js",
    "ui.d.ts",
    "ui.css",
    "menu/",
    "README.md"
  ],
  "peerDependencies": {
    "clsx": ">=2",
    "lucide-react": ">=0.400",
    "radix-ui": ">=1.4",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwind-merge": ">=2"
  },
  "peerDependenciesMeta": {
    "clsx": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  },
  "devDependencies": {
    "apache-arrow": "17.0.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  }
}
