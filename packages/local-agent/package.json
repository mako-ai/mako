{
  "name": "@mako/local-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Mako Local Agent: a small localhost daemon that lets app.mako.ai query databases running on this machine. Credentials are stored encrypted on disk and never leave the machine.",
  "main": "src/index.ts",
  "bin": {
    "mako-agent": "./bin/mako-agent.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
