{
  "name": "data-analytics-platform",
  "version": "1.0.0",
  "description": "Analytics platform syncing data from multiple sources like Close.com, Stripe, and databases",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm --filter app run dev\" \"pnpm --filter api run dev\" \"pnpm dlx inngest-cli@latest dev\" \"./scripts/sandbox-tunnel.sh\"",
    "sandbox:tunnel": "./scripts/sandbox-tunnel.sh",
    "consoles:migrate": "pnpm --filter api exec tsx src/apps/migrate-consoles.cli.ts",
    "flows:export": "pnpm --filter api exec tsx src/services/flow-config-export.cli.ts",
    "artifacts:cors": "pnpm --filter api exec tsx src/services/artifact-bucket-cors.cli.ts",
    "apps:purge-v1-artifacts": "pnpm --filter api exec tsx src/apps/purge-v1-artifacts.cli.ts",
    "dev:tunnel": "concurrently \"pnpm dev\" \"cloudflared tunnel --url http://localhost:5173 --no-tls-verify\"",
    "build": "pnpm run lint:fix:all && pnpm run build:ci",
    "build:ci": "pnpm --filter @mako/schemas run build && pnpm --filter @mako/agent-tools run build && pnpm run app:build && pnpm run api:build && node scripts/check-connector-agnosticism.js",
    "start": "node dist/index.js",
    "format": "prettier --write \"api/**/*.ts\"",
    "migrate": "tsx -r dotenv/config api/src/migrations/cli.ts",
    "query": "tsx api/src/sync/query-runner.ts",
    "backfill:descriptions": "tsx api/src/scripts/backfill-console-descriptions.ts",
    "migrate:user-folders": "tsx api/src/scripts/migrate-user-folders-to-handles.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:rebuild": "docker compose down && docker compose build && docker compose up -d",
    "docker:clean": "docker compose down -v",
    "app:dev": "pnpm --filter app run dev",
    "app:dev:scan": "pnpm --filter app run dev:scan",
    "app:build": "pnpm --filter app run build",
    "app:preview": "pnpm --filter app run preview",
    "app:lint": "pnpm --filter app run lint",
    "app:lint:fix": "pnpm --filter app run lint:fix",
    "api:dev": "pnpm --filter api run dev",
    "api:build": "pnpm --filter api run build",
    "api:start": "pnpm --filter api run start",
    "api:lint": "pnpm --filter api run lint",
    "api:lint:fix": "pnpm --filter api run lint:fix",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm run openapi:generate && pnpm --filter docs run build",
    "openapi:generate": "pnpm --filter api run openapi:generate",
    "api-types:generate": "pnpm --filter app run generate:api-types",
    "openapi:sync": "pnpm run openapi:generate && pnpm run api-types:generate",
    "agent:dev": "pnpm --filter @mako/local-agent run dev",
    "agent:start": "pnpm --filter @mako/local-agent run start",
    "desktop:dev": "pnpm --filter @mako/desktop run dev",
    "lint:all": "pnpm run app:lint && pnpm run api:lint && node scripts/check-connector-agnosticism.js",
    "lint:fix:all": "pnpm run app:lint:fix && pnpm run api:lint:fix && node scripts/check-connector-agnosticism.js",
    "install:all": "pnpm install -r",
    "cf:login": "wrangler login",
    "cf:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "cf:tail": "wrangler tail --config cloudflare/wrangler.toml",
    "cf:kv:create": "wrangler kv namespace create MAKO_PR_DEPLOYMENTS",
    "cf:kv:list": "wrangler kv key list --namespace-id=$CLOUDFLARE_KV_NAMESPACE_ID",
    "cf:app:test": "node --test cloudflare/app-router/worker.test.mjs",
    "cf:app:check": "pnpm dlx wrangler@4.110.0 deploy --config cloudflare/app-router/wrangler.jsonc --dry-run",
    "cf:app:check:canary": "pnpm dlx wrangler@4.110.0 deploy --config cloudflare/app-router/wrangler.canary.jsonc --dry-run",
    "cf:app:deploy": "pnpm dlx wrangler@4.110.0 deploy --config cloudflare/app-router/wrangler.jsonc",
    "cf:app:deploy:canary": "pnpm dlx wrangler@4.110.0 deploy --config cloudflare/app-router/wrangler.canary.jsonc",
    "cf:app:tail": "pnpm dlx wrangler@4.110.0 tail --config cloudflare/app-router/wrangler.jsonc",
    "preview-db:list": "./scripts/manage-preview-db.sh list",
    "preview-db:create": "./scripts/manage-preview-db.sh create",
    "preview-db:delete": "./scripts/manage-preview-db.sh delete",
    "prepare": "husky",
    "secrets": "tsx scripts/secrets.ts",
    "secrets:pull": "tsx scripts/secrets.ts pull",
    "secrets:push": "tsx scripts/secrets.ts push",
    "secrets:list": "tsx scripts/secrets.ts list",
    "secrets:diff": "tsx scripts/secrets.ts diff",
    "secrets:salvage-prod": "tsx scripts/secrets.ts salvage-prod",
    "sandbox:tunnel:setup": "bash scripts/sandbox-tunnel-setup.sh",
    "flows:validate": "pnpm --filter api exec tsx src/services/flow-validate.cli.ts"
  },
  "keywords": [
    "analytics",
    "data-sync",
    "close-crm",
    "stripe",
    "mongodb",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dotenv": "^18.0.7"
  },
  "lint-staged": {
    "app/**/*.{ts,tsx}": [
      "eslint --fix --report-unused-disable-directives",
      "prettier --write"
    ],
    "api/**/*.ts": [
      "eslint --fix --report-unused-disable-directives",
      "prettier --write"
    ],
    "api/src/**/*.test.ts": [
      "bash -c 'pnpm --filter api exec tsx src/test-coverage.test.ts'"
    ],
    "{api/src/routes/**/*.ts,api/src/openapi/**/*.ts,packages/schemas/src/**,packages/agent-tools/src/**}": [
      "bash -c 'pnpm run openapi:sync && git add docs/src/openapi/mako-api.json app/src/api/schema.d.ts'"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  }
}
