MAKO_E2E_BASE_URL=http://localhost:5173
# TesterArmy's browser agent uses Vercel AI Gateway (also used by Mako chat).
AI_GATEWAY_API_KEY=
MAKO_E2E_MODEL=openai/gpt-6-luna-fast
MAKO_E2E_MONGODB_URI=mongodb://127.0.0.1:27017/mako_e2e?replicaSet=rs0
# oauth: real browser login; installation: isolated local CI fixture
MAKO_E2E_GITHUB_AUTH=oauth
MAKO_E2E_GITHUB_STATE=.e2e/github-state.json
MAKO_E2E_GITHUB_REPO=
# For a PR preview, set a fresh receiving address and its real email-code file:
# MAKO_E2E_EMAIL=
# MAKO_E2E_VERIFICATION_FILE=.e2e/verification.json
E2E_TELEMETRY_DISABLED=1
