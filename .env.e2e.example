MAKO_E2E_BASE_URL=http://127.0.0.1:5173
# 1: the runner starts Mako with loopback GitHub/AI fakes (requires fake below).
MAKO_E2E_START_APP=0
# fake: isolated fixture (with MAKO_E2E_START_APP=1); oauth: existing server.
MAKO_E2E_GITHUB_AUTH=oauth
# Browser agent only; not needed to replay .e2e/cache. Use a budgeted key.
AI_GATEWAY_API_KEY=
MAKO_E2E_MODEL=openai/gpt-6-luna-fast
MAKO_E2E_MONGODB_URI=mongodb://127.0.0.1:27017/mako_e2e?replicaSet=rs0
# OAuth mode only:
MAKO_E2E_GITHUB_STATE=.e2e/github-state.json
MAKO_E2E_GITHUB_REPO=
E2E_TELEMETRY_DISABLED=1
