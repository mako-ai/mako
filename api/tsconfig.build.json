{
  "extends": "./tsconfig.json",
  // The emitted server is CommonJS. tsconfig.json itself type-checks with
  // "module": "preserve" so the vitest suites (ESM: top-level await,
  // import.meta) type-check alongside the code (`tsc --noEmit -p .`).
  "compilerOptions": {
    "module": "commonjs"
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/database/pg/drizzle.config.ts",
    "src/database/pg/test-pglite.ts",
    "src/test-support/pg-test.ts",
    "src/databases/test-support/**"
  ]
}
