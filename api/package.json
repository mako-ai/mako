{
  "name": "api",
  "version": "1.0.0",
  "description": "Hono API backend for query execution",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --include \"src/**/*\" src/index.ts",
    "build": "cd ../packages/schemas && node ../../api/node_modules/typescript/bin/tsc && cd ../../api && node ./node_modules/typescript/bin/tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "start": "tsx src/index.ts",
    "openapi:generate": "tsx src/openapi/generate-cli.ts",
    "tools:measure": "tsx src/scripts/measure-tool-tokens.ts",
    "test": "pnpm --filter @mako/agent-tools build && node --import tsx scripts/run-tsx-tests.mjs && vitest run --config vitest.apps.config.ts",
    "test:dbt": "vitest run",
    "test:dbt:watch": "vitest",
    "test:destinations": "vitest run --config vitest.destinations.config.ts",
    "test:destinations:watch": "vitest --config vitest.destinations.config.ts",
    "test:apps": "vitest run --config vitest.apps.config.ts",
    "apps:build-template": "tsx src/apps/e2b-template.ts",
    "apps:build-connector-template": "E2B_TEMPLATE_ALIAS=mako-connector-sync E2B_TEMPLATE_MEMORY_MB=4096 tsx src/apps/e2b-template.ts",
    "test:apps:watch": "vitest --config vitest.apps.config.ts",
    "test:pg": "vitest run src/database/pg src/migration src/repositories",
    "test:tsx": "node --import tsx scripts/run-tsx-tests.mjs",
    "pg:generate": "drizzle-kit generate --config src/database/pg/drizzle.config.ts",
    "pg:migrate": "tsx -r dotenv/config src/migration/cli/migrate.ts",
    "pg:backfill": "tsx -r dotenv/config src/migration/cli/backfill.ts",
    "pg:verify": "tsx -r dotenv/config src/migration/cli/verify.ts",
    "pg:mode": "tsx -r dotenv/config src/migration/cli/mode.ts",
    "pg:rewrite-user-ids": "tsx -r dotenv/config src/migration/cli/rewrite-user-ids.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --fix"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.24"
    }
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.110",
    "@ai-sdk/mcp": "^2.0.73",
    "@ai-sdk/otel": "1.0.137",
    "@clickhouse/client": "^1.24.1",
    "@deepnote/blocks": "5.0.0",
    "@duckdb/node-api": "2.0.0-r.1",
    "@google-cloud/bigquery": "^9.2.0",
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@google-cloud/storage": "^8.4.0",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "1.6.3",
    "@kubernetes/client-node": "^2.0.0",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@logtape/logtape": "^2.4.1",
    "@mako/agent-tools": "workspace:*",
    "@mako/schemas": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@scalar/hono-api-reference": "^0.12.11",
    "@tavily/core": "^0.7.14",
    "acorn": "8.19.0",
    "ai": "7.0.137",
    "apache-arrow": "^21.2.0",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.2",
    "diff": "^9.0.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "e2b": "^2.55.0",
    "google-auth-library": "^11.2.0",
    "hono": "^4.13.18",
    "inngest": "^4.23.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "js-yaml": "^5.4.3",
    "mongodb": "~7.7.0",
    "mongoose": "~9.11.4",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "nanoid": "^6.0.2",
    "parquet-wasm": "^0.9.0",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.1",
    "resumable-stream": "^2.2.13",
    "sharp": "^0.35.5",
    "ssh2": "^1.17.0",
    "stripe": "^23.0.0",
    "undici": "^8.12.4",
    "unpdf": "^1.8.1",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
