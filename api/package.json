{
  "name": "api",
  "version": "1.0.0",
  "description": "Hono API backend for query execution",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm run lint && cd ../packages/schemas && node ../../api/node_modules/typescript/bin/tsc && cd ../../api && node ./node_modules/typescript/bin/tsc -p tsconfig.build.json && copyfiles -u 1 'src/**/*.svg' 'src/agent-skills/**/*.md' 'src/**/*.py' dist",
    "start": "tsx src/index.ts",
    "sync": "tsx src/sync/cli.ts",
    "seed:dbt-demo": "tsx src/scripts/seed-dbt-engine-demo.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "migrate:workspaces": "tsx src/migrations/migrate-to-workspaces.ts",
    "openapi:generate": "tsx src/openapi/generate-cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "tsx src/openapi/core.test.ts && tsx src/openapi/openapi.test.ts && tsx src/dbt/warm-dir-cache.test.ts",
    "test:pg": "tsx src/db/ids.test.ts && tsx src/db/repositories.test.ts && tsx src/db/persistence.routes.test.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --fix"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.124",
    "@clickhouse/client": "^1.14.0",
    "@duckdb/node-api": "1.5.0-r.1",
    "@google-cloud/bigquery": "^8.1.1",
    "@google-cloud/cloud-sql-connector": "^1.8.4",
    "@google-cloud/storage": "^7.19.0",
    "@hono/node-server": "^1.14.4",
    "@hono/zod-openapi": "1.3.0",
    "@langfuse/otel": "^5.4.1",
    "@langfuse/tracing": "^5.4.1",
    "@logtape/logtape": "^1.0.4",
    "@mako/agent-tools": "workspace:*",
    "@mako/schemas": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@scalar/hono-api-reference": "^0.11.3",
    "ai": "6.0.196",
    "apache-arrow": "^21.1.0",
    "arctic": "^3.7.0",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.3.0",
    "diff": "^9.0.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.4.0",
    "hono": "^4.7.11",
    "inngest": "^3.54.1",
    "inquirer": "^8.2.6",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.1.0",
    "mongodb": "^6.17.0",
    "mongoose": "^8.15.1",
    "mssql": "^11.0.1",
    "mysql2": "^3.14.1",
    "nanoid": "^5.1.7",
    "openai": "^5.2.0",
    "parquet-wasm": "^0.7.1",
    "pg": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resumable-stream": "^2.2.12",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "ssh2": "^1.17.0",
    "stripe": "^14.25.0",
    "uuid": "^9.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/diff": "^8.0.0",
    "@types/inquirer": "^8.2.11",
    "@types/js-yaml": "^4.0.9",
    "@types/mssql": "^9.1.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
