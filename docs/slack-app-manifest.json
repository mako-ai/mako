{
  "display_information": {
    "name": "Mako",
    "description": "AI data platform agent for Slack — search messages, read channels, and send replies with per-action approval.",
    "background_color": "#0B0B0B"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Mako",
      "always_online": false
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "https://app.mako.ai/api/mcp/oauth/callback",
      "http://localhost:5173/api/mcp/oauth/callback"
    ],
    "scopes": {
      "user": [
        "search:read.public",
        "search:read.private",
        "search:read.im",
        "search:read.mpim",
        "search:read.files",
        "search:read.users",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "channels:read",
        "groups:read",
        "mpim:read",
        "users:read",
        "users:read.email",
        "canvases:read",
        "reactions:read",
        "emoji:read",
        "files:read",
        "chat:write",
        "reactions:write",
        "canvases:write"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
