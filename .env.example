# Application Database
# Local development connects to the shared `dev` database (an Atlas DB refreshed
# nightly from production). Use the `dev` connection string from the team vault.
#   - `dev`        → local development (this DATABASE_URL)
#   - `staging`    → non-migration PR previews (deployed automatically)
#   - `production` → prod (never point local at this)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dev

# Encryption key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# MongoDB Atlas Password (referenced in config.yaml)
MONGO_ATLAS_PASSWORD=your-atlas-password-here

# Close.com API Keys
CLOSE_API_KEY_SWITZERLAND=your-close-api-key-ch
CLOSE_API_KEY_ITALY=your-close-api-key-it
CLOSE_API_KEY_FRANCE=your-close-api-key-fr
CLOSE_API_KEY_SPAIN=your-close-api-key-es

# Stripe API Keys
STRIPE_API_KEY_SPAIN=your-stripe-api-key-es

# RealAdvisor GraphQL
REALADVISOR_HASURA_SECRET=your-hasura-secret

# OAuth Providers (for authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GH_CLIENT_ID=your-github-client-id
GH_CLIENT_SECRET=your-github-client-secret

# GitHub App (for connecting dbt/Transform projects to repositories).
# Distinct from the GH_CLIENT_* login OAuth above. Leave unset to import only
# public repos by owner/repo; set GITHUB_DEV_TOKEN to a PAT for local testing
# of private repos, or configure a full GitHub App for production installs.
# Quick setup: node scripts/register-github-app.mjs (manifest flow → updates .env)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_DEV_TOKEN=

# Session Configuration
SESSION_SECRET=your-session-secret

# Application URLs
PUBLIC_URL=http://localhost:5173
API_URL=http://localhost:3000
BASE_URL=http://localhost:8080
CLIENT_URL=http://localhost:5173

# OAuth Proxy (for non-production environments: localhost, PR previews)
# Set PRODUCTION_URL to the production API origin so OAuth callbacks
# route through production. Leave unset in production itself.
# PRODUCTION_URL=https://app.mako.co
# Comma-separated list of additional trusted origins for OAuth redirects
# TRUSTED_ORIGINS=https://my-preview.vercel.app

# Node Environment
NODE_ENV=development

# Optional: bcrypt rounds for password hashing
BCRYPT_ROUNDS=10

# Optional: MongoDB connection options
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# Optional: startup DB connection retry/backoff. The initial connect runs
# before the server listens, so these let a transient Atlas blip (e.g.
# ReplicaSetNoPrimary during a failover) be retried instead of aborting boot.
# Defaults: 5 attempts, 1000ms base delay, 5000ms max delay (exponential).
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_BASE_DELAY_MS=1000
DB_CONNECT_MAX_DELAY_MS=5000

# Port Configuration
WEB_API_PORT=8080

# Dashboard Materialization (optional - defaults to filesystem)
# For local GCS materialization, use a service-account credential file because
# signed URL generation requires credentials with a private key.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/dev-service-account.json
# DASHBOARD_ARTIFACT_STORE=gcs
# GCS_DASHBOARD_BUCKET=revops-462013-dashboard-artifacts
# DASHBOARD_ARTIFACT_PREFIX=dashboard-artifacts/local-yourname

# Chat image attachments reuse the same object store configured above
# (DASHBOARD_ARTIFACT_STORE + GCS_DASHBOARD_BUCKET / S3_* settings). Images are
# stored under the `chat-attachments/` prefix instead of being inlined as
# base64 in the chat document, then served lazily via an authenticated proxy at
# /api/workspaces/:workspaceId/chat-images/:attachmentId. No extra config is
# required; defaults to local filesystem when unset.

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=5

# Resumable chat streams (optional)
# In-flight AI chat turns are buffered so clients can reconnect (page refresh,
# second device, multiple viewers). Without REDIS_URL this uses an in-process
# buffer — fine for local dev and single-instance self-hosting. Set REDIS_URL
# (any Redis-compatible server: Redis, Valkey, GCP Memorystore, Upstash) when
# running more than one API instance so resume requests can reach streams
# produced by other instances.
# REDIS_URL=redis://localhost:6379

# Inngest
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
# Optional for non-production branch deployments
# INNGEST_ENV=pr-123
# INNGEST_SERVE_ORIGIN=http://localhost:8080
# DISABLE_SCHEDULED_SYNC=false
# Max in-flight CDC materializations globally (caps BigQuery slot pressure, default 8)
# CDC_MATERIALIZE_CONCURRENCY=8
# Max in-flight CDC materializations per flow (prevents one flow from starving others, default 3)
# CDC_MATERIALIZE_CONCURRENCY_PER_FLOW=3
# Max wait for a single BigQuery MERGE job in CDC materialization, in ms (default 900000 = 15min)
# BIGQUERY_MERGE_MAX_WAIT_MS=900000

# Vercel AI Gateway (REQUIRED for all AI features)
# Generate a key at: Vercel Dashboard > AI Gateway settings
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# Optional: Embeddings only (text-embedding-3-small via raw OpenAI SDK)
OPENAI_API_KEY=your-openai-api-key

# Optional: Web search for the agent (enables web_search tool; fetch_url works without it)
TAVILY_API_KEY=your-tavily-api-key

# Langfuse LLM observability (optional — tracing is a no-op when keys are unset)
# Keys: Langfuse UI > Settings > API Keys. Region base URLs:
#   EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Optional: override the Langfuse "environment" label (defaults to NODE_ENV)
# LANGFUSE_TRACING_ENVIRONMENT=development

# SendGrid Email Service (for invitations and verification)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_INVITATION_TEMPLATE_ID=d-xxxxx  # Optional: Dynamic template ID
SENDGRID_VERIFICATION_TEMPLATE_ID=d-xxxxx  # Optional: Dynamic template ID

# Logo shown at the top of run-notification emails. Defaults to the PNG hosted
# at https://app.mako.ai/email/mako-logo.png (served from app/public/email/).
# Override for self-hosted deploys or staging where app.mako.ai isn't reachable.
# EMAIL_LOGO_URL=https://your-app-domain.example.com/email/mako-logo.png

# Billing / Subscription (optional — off by default for self-hosted)
# Set BILLING_ENABLED=true to activate usage gating and Stripe integration.
# When false (default), all users get unlimited access to all models.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx       # Stripe Price ID for the Pro monthly subscription
STRIPE_METER_EVENT_NAME=llm_usage_usd  # Legacy Stripe meter event name; payload value is still sent in cents

# Git-native Apps v2 (disabled by default)
APPS_V2_ENABLED=false
# Optional GitHub mirror for conversation branches. Mako Git remains canonical.
APPS_V2_GITHUB_PUSH_ENABLED=false
# Required when NODE_ENV=production. Development defaults to /tmp/mako-apps-v2-git.
APPS_V2_GIT_ROOT=
# Required in production/Cloud Run when Apps v2 is enabled. Confirm only after
# the configured Git root is backed by durable, operationally verified storage.
APPS_V2_GIT_DURABILITY_CONFIRMED=false
# PR previews only: allow explicitly ephemeral Git storage when BASE_URL and
# INNGEST_ENV both identify the same pr-<number> environment.
APPS_V2_ALLOW_EPHEMERAL_GIT=false
# Per-repository bare Git storage quota (default 100 MiB).
APPS_V2_MAX_REPOSITORY_BYTES=104857600
# Isolated Apps v2 execution is independently disabled unless set to "e2b".
APPS_V2_SANDBOX_PROVIDER=off
# Required only when APPS_V2_SANDBOX_PROVIDER=e2b. The API key remains in the
# control plane; it is never copied into a sandbox environment.
E2B_API_KEY=
# Build the versioned template with `pnpm --filter api run e2b:build-template`;
# optionally set E2B_TEMPLATE_ALIAS for the account-facing build alias. Copy the
# immutable templateId printed by that command here.
E2B_TEMPLATE_ALIAS=mako-apps-v2
# Required immutable E2B template ID. There is no mutable/default fallback.
E2B_TEMPLATE_ID=
# Required unprivileged user baked into the pinned custom template. The template
# must provide setsid, Python 3, no sudo/capabilities, and blocked metadata IPs.
APPS_V2_E2B_USER=mako

# Super admin allow-list (optional)
# Comma-separated email addresses that unlock the cross-workspace "Super Admin"
# settings panel (model catalog curation, platform defaults). Leave unset in
# production to disable super-admin powers entirely.
SUPER_ADMIN_EMAILS=
