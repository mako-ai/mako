# Application Database
# Local development connects to the shared `dev` database (an Atlas DB refreshed
# nightly from production). Use the `dev` connection string from the team vault.
#   - `dev`        → local development (this DATABASE_URL)
#   - `staging`    → non-migration PR previews (deployed automatically)
#   - `production` → prod (never point local at this)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dev

# Encryption key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Connection string for "Try with Demo Database" in onboarding. Empty: the
# button creates a connection with no connection string.
DEMO_DATABASE_URL=

# OAuth login providers. Each provider is enabled only when its id AND secret
# are set; leave empty to use email/password (and DEV_LOGIN_PASSWORD) locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GH_CLIENT_ID=
GH_CLIENT_SECRET=
# DISABLE_OAUTH=true          # hide OAuth buttons server-side
# VITE_DISABLE_OAUTH=true     # ...and in the app build

# GitHub App (Mako AI — formerly Mako Transforms). Workspace repo linking,
# dbt Git sync, and the install URL all use this App. Distinct from the
# GH_CLIENT_* login OAuth above. Leave unset to import only public repos by
# owner/repo; set GITHUB_DEV_TOKEN to a PAT for local testing of private repos.
# Quick setup: node scripts/register-github-app.mjs (manifest flow → updates .env)
# Slug is whatever GitHub currently has for that App — do not invent `mako`.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_DEV_TOKEN=
# The App's OAuth client (user-to-server tokens; also reusable for the GitHub
# MCP connector below).
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_API_BASE_URL=https://api.github.com

# Session Configuration
SESSION_SECRET=your-session-secret

# Application URLs
PUBLIC_URL=http://localhost:5173
BASE_URL=http://localhost:8080
CLIENT_URL=http://localhost:5173

# OAuth Proxy (for non-production environments: localhost, PR previews)
# Set PRODUCTION_URL to the production API origin so OAuth callbacks
# route through production. Leave unset in production itself.
# PRODUCTION_URL=https://app.mako.co
# Comma-separated list of additional trusted origins for OAuth redirects
# TRUSTED_ORIGINS=https://my-preview.vercel.app

# Node Environment
NODE_ENV=development

# Optional: bcrypt rounds for password hashing
BCRYPT_ROUNDS=10

# Optional: startup DB connection retry/backoff. The initial connect runs
# before the server listens, so these let a transient Atlas blip (e.g.
# ReplicaSetNoPrimary during a failover) be retried instead of aborting boot.
# Defaults: 5 attempts, 1000ms base delay, 5000ms max delay (exponential).
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_BASE_DELAY_MS=1000
DB_CONNECT_MAX_DELAY_MS=5000

# Port Configuration
WEB_API_PORT=8080

# Dashboard Materialization (optional - defaults to filesystem)
# For local GCS materialization, use a service-account credential file because
# signed URL generation requires credentials with a private key.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/dev-service-account.json
# DASHBOARD_ARTIFACT_STORE=gcs
# GCS_DASHBOARD_BUCKET=your-gcp-project-dashboard-artifacts
# DASHBOARD_ARTIFACT_PREFIX=dashboard-artifacts/local-yourname
# Filesystem store root when DASHBOARD_ARTIFACT_STORE is unset:
# DASHBOARD_ARTIFACT_DIR=
# S3-compatible store instead of GCS (DASHBOARD_ARTIFACT_STORE=s3):
# S3_DASHBOARD_BUCKET=
# S3_REGION=
# S3_ENDPOINT=                 # for MinIO / R2 etc.
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
#
# App parquet artifacts are served as 302s to short-lived signed bucket URLs
# when the store supports it (browser downloads straight from the bucket);
# the API verifies/installs the bucket's CORS rule on first use and falls
# back to proxied streaming when it can't. Override the probe if needed:
# "on" trusts the bucket's CORS without checking, "off" always streams.
# APPS_ARTIFACT_REDIRECTS=on
#
# App binding parquet compression. Applies only to app binding artifacts:
# CDC and sync loads always write SNAPPY. Allowed: SNAPPY, ZSTD. Default ZSTD
# level 3. DuckDB-WASM 1.29 (app-sdk) and DuckDB/pyarrow read ZSTD. Plain
# hyparquet needs hyparquet-compressors. Validated at boot: an invalid value
# stops the API from starting. Existing files stay readable (parquet records
# its own codec).
# PARQUET_COMPRESSION=ZSTD
# PARQUET_ZSTD_LEVEL=3
# Optional override; DuckDB's COPY default is 122880 rows per row group.
# PARQUET_ROW_GROUP_SIZE=122880
#
# App binding row limits. A binding gets PARQUET_ROW_LIMIT rows unless its
# front matter says `-- row_limit: <n>`, which may go up to
# PARQUET_MAX_ROW_LIMIT. A query past its limit fails the build (never
# truncates). Accepts 2000000, 2_000_000 or 2M. Validated at boot.
# PARQUET_ROW_LIMIT=2000000
# PARQUET_MAX_ROW_LIMIT=5000000

# Chat-with-app parquet: DuckDB 2.0 can read the GCS object via httpfs
# (async I/O) instead of copying it to a local cache first. Default OFF.
# When on, prefers a short-lived signed https URL (DuckDB holds no bucket
# credentials; HTTP writes are unimplemented). If signing fails, reads
# gs://bucket/key with either GCS HMAC interoperability keys or a
# short-lived OAuth bearer token from the artifact-store ADC / service
# account (same client as @google-cloud/storage, scoped
# devstorage.read_only — not the workspace GCS connector).
# gs:// is a weaker sandbox: DuckDB may PUT to the allow-listed object if
# the principal can write (HMAC keys are not forced read-only; OAuth is).
# The repo does not ship HMAC keys; set these only if you have them:
#   GCS_HMAC_KEY_ID=...
#   GCS_HMAC_SECRET=...
# APP_CHAT_PARQUET_DIRECT_GCS=1
# Direct mode LOADs httpfs and never downloads it. The Docker image bakes it
# into /opt/duckdb-extensions. Locally, bake it into ~/.duckdb/extensions with
#   pnpm --filter api exec tsx src/apps/duckdb-extensions.ts
# DUCKDB_EXTENSION_DIRECTORY=/opt/duckdb-extensions
#
# Per-app origins (api/src/apps/app-origin.ts), OFF unless set. Published apps
# are served from https://<appId>.<domain> and framed WITH allow-same-origin,
# so the browser cache works (WASM, bundle, parquet). Must be a registrable
# domain separate from CLIENT_URL's (a mako.ai subdomain is refused). Locally,
# e.g. http://makoapps.test:8080 plus a resolver rule mapping it to 127.0.0.1.
# APPS_ORIGIN_BASE=https://makousercontent.com
# How long one view-token URL stays identical (seconds, default 3600) and one
# signed parquet URL (default 21600). Longer = more cache hits, longer-lived
# bearer URLs.
# APPS_ORIGIN_TOKEN_WINDOW_SECONDS=3600
# APPS_STABLE_SIGNED_URL_WINDOW_SECONDS=21600
# Extra origins allowed to frame app hosts besides CLIENT_URL (space-separated).
# APPS_ORIGIN_FRAME_ANCESTORS=https://app-canary.mako.ai

# Chat image attachments reuse the same object store configured above
# (DASHBOARD_ARTIFACT_STORE + GCS_DASHBOARD_BUCKET / S3_* settings). Images are
# stored under the `chat-attachments/` prefix instead of being inlined as
# base64 in the chat document, then served lazily via an authenticated proxy at
# /api/workspaces/:workspaceId/chat-images/:attachmentId. No extra config is
# required; defaults to local filesystem when unset.

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=5

# Per-caller API budget (api/src/middleware/rate-limit.ts): cost units per
# minute per session/token/IP, shared across instances via REDIS_URL.
# shadow (default) logs who would be refused; enforce returns 429; off.
# API_RATE_LIMIT_MODE=shadow
# API_RATE_LIMIT_PER_MINUTE=1200
# Require requests to come through Cloudflare (api/src/middleware/edge-origin.ts):
# a Transform Rule sets `x-mako-edge: <secret>`. Unset = off; set = shadow
# unless EDGE_ORIGIN_CHECK=enforce.
# EDGE_ORIGIN_SECRET=
# EDGE_ORIGIN_CHECK=shadow

# Resumable chat streams (optional)
# In-flight AI chat turns are buffered so clients can reconnect (page refresh,
# second device, multiple viewers). Without REDIS_URL this uses an in-process
# buffer — fine for local dev and single-instance self-hosting. Set REDIS_URL
# (any Redis-compatible server: Redis, Valkey, GCP Memorystore, Upstash) when
# running more than one API instance so resume requests can reach streams
# produced by other instances.
# REDIS_URL=redis://localhost:6379

# Inngest. Leave empty locally: `pnpm dev` runs the Inngest dev server, which
# needs no keys. Set both for Inngest Cloud.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional for non-production branch deployments
# INNGEST_ENV=pr-123
# INNGEST_SERVE_ORIGIN=http://localhost:8080
# DISABLE_SCHEDULED_SYNC=false
# Days a finished flow run (flow_executions) is kept before its TTL expires it; running runs never expire (default 90)
# FLOW_EXECUTION_RETENTION_DAYS=90
# Max in-flight CDC materializations globally (caps BigQuery slot pressure, default 8)
# CDC_MATERIALIZE_CONCURRENCY=8
# Max in-flight CDC materializations per flow (prevents one flow from starving others, default 3)
# CDC_MATERIALIZE_CONCURRENCY_PER_FLOW=3
# Max wait for a single BigQuery MERGE job in CDC materialization, in ms (default 900000 = 15min)
# BIGQUERY_MERGE_MAX_WAIT_MS=900000

# Vercel AI Gateway (REQUIRED for all AI features)
# Generate a key at: Vercel Dashboard > AI Gateway settings
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# Optional: Embeddings only (text-embedding-3-small via raw OpenAI SDK)
OPENAI_API_KEY=

# Optional: deployment-wide Slack app for the Slack MCP connector.
# Slack's MCP server (mcp.slack.com) only accepts pre-registered confidential
# OAuth apps. Register ONE app (api.slack.com/apps, enable "Agents & AI Apps"
# → MCP) and add the redirect URL that Mako actually uses:
#   ${PUBLIC_URL:-$CLIENT_URL}/api/mcp/oauth/callback
# (local default: http://localhost:5173/api/mcp/oauth/callback). Then set:
# SLACK_MCP_CLIENT_ID=1234567890.0987654321
# SLACK_MCP_CLIENT_SECRET=your-slack-app-client-secret
# Unset: workspace admins supply their own app's client ID/secret in Settings.

# Optional: deployment-wide GitHub OAuth app for the GitHub MCP connector.
# GitHub's MCP server (api.githubcopilot.com/mcp/) does not support Dynamic
# Client Registration. Register ONE OAuth App (github.com/settings/developers)
# with the Authorization callback URL Mako actually uses:
#   ${PUBLIC_URL:-$CLIENT_URL}/api/mcp/oauth/callback
# (local default: http://localhost:5173/api/mcp/oauth/callback). Then set:
# GITHUB_MCP_CLIENT_ID=Iv1.your-github-oauth-app-id
# GITHUB_MCP_CLIENT_SECRET=your-github-oauth-app-client-secret
# Deployments running the Mako GitHub App (dbt Git sync) can reuse its OAuth
# client here (GITHUB_APP_CLIENT_ID/SECRET values): GitHub Apps allow multiple
# callback URLs, so add /api/mcp/oauth/callback to the App's callback URLs.
# Access is then user ∩ app installation. Reusing the GH_CLIENT_* login app
# instead works ONLY if its registered callback URL is a common parent of both
# redirect paths (OAuth Apps allow a single callback URL; each redirect_uri
# must be it or a subdirectory of it).
# Unset: workspace admins supply their own app's client ID/secret in Settings,
# or members authenticate with a personal access token instead.

# Optional: Web search for the agent (enables web_search tool; fetch_url works without it)
TAVILY_API_KEY=
# MCP connectors may reach private/loopback URLs only when set (local testing).
# MCP_ALLOW_PRIVATE_URLS=true

# Langfuse LLM observability (optional — tracing is a no-op when keys are unset)
# Keys: Langfuse UI > Settings > API Keys. Region base URLs:
#   EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Optional: override the Langfuse "environment" label (defaults to NODE_ENV)
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=

# SendGrid Email Service (for invitations and verification). Leave
# SENDGRID_API_KEY empty locally: the API then uses its dev email fallback
# instead of calling SendGrid (any value, even a placeholder, turns SendGrid on).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# Optional dynamic template IDs (d-...). Empty: built-in templates.
SENDGRID_INVITATION_TEMPLATE_ID=
SENDGRID_VERIFICATION_TEMPLATE_ID=
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=

# Logo shown at the top of run-notification emails. Defaults to the PNG hosted
# at https://app.mako.ai/email/mako-logo.png (served from app/public/email/).
# Override for self-hosted deploys or staging where app.mako.ai isn't reachable.
# EMAIL_LOGO_URL=https://your-app-domain.example.com/email/mako-logo.png

# Billing / Subscription (optional — off by default for self-hosted)
# Set BILLING_ENABLED=true to activate usage gating and Stripe integration.
# When false (default), all users get unlimited access to all models.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=       # Stripe Price ID for the Pro monthly subscription (price_...)
# STRIPE_OVERAGE_PRICE_ID=  # metered overage price (price_...)
STRIPE_METER_EVENT_NAME=llm_usage_usd  # Legacy Stripe meter event name; payload value is still sent in cents

# Super admin allow-list (optional)
# Comma-separated email addresses that unlock the cross-workspace "Super Admin"
# settings panel (model catalog curation, platform defaults). Leave unset in
# production to disable super-admin powers entirely.
SUPER_ADMIN_EMAILS=

# Notebook Python kernel (local dev)
# `code` cells run on a managed kernel. Locally, start the sidecar kernel with
# `pnpm docker:up` and set these so the API's StaticKernelProvider drives it.
# (Deployed environments use the GKE KernelProvider — see deploy/notebook-kernels.)
KERNEL_PROVIDER=static
KERNEL_GATEWAY_URL=http://localhost:8888
# Base URL the kernel uses to reach this API for mako.sources reads. From the
# kernel container the host is host.docker.internal (mapped in docker-compose).
NOTEBOOK_KERNEL_API_URL=http://host.docker.internal:8080
# Shared secret the kernel presents on mako.sources reads (deployed envs).
# NOTEBOOK_KERNEL_SECRET=
# Notebook file storage bucket/prefix (deployed envs; local filesystem when unset).
# NOTEBOOK_GCS_BUCKET=
# NOTEBOOK_GCS_PREFIX=
# GKE kernel provider (deployed envs only):
# KERNEL_GKE_ENDPOINT=
# KERNEL_GKE_CA_CERT=
# KERNEL_NAMESPACE=
# KERNEL_POOL_DEPLOYMENT=

# dbt engine (runs dbt for workspace projects). Defaults suit the Docker image.
# DBT_ENGINE_ENABLED=true
# DBT_ENGINE_MAX_PROCESSES=
# DBT_VENV_BIN=

# Public base URL for inbound connector webhooks (defaults to BASE_URL).
# WEBHOOK_PUBLIC_BASE_URL=

# Workspace connector bundles (rfcs/connector-runtime.md §5, iteration 1).
# Off by default. On: a connectors/<slug>/ folder with package.json and
# package-lock.json is built into one .mjs per source hash in an E2B build box,
# stored in the artifact store under connector-bundles/<workspaceId>/<hash>.mjs,
# and run from that bundle. A folder that commits node_modules/ is refused with
# the flag on or off.
# CONNECTOR_BUNDLES_ENABLED=true

# Workflows (docs/src/content/docs/workflows.md, deploy/workflows). Optional: leave all
# of this unset and Mako runs without workflows.
#
# Production: a token from Hatchet Cloud or your own Hatchet, and the worker
# container (deploy/workflows/README.md):
#   HATCHET_CLIENT_TOKEN=<token>
#   HATCHET_DASHBOARD_URL=https://cloud.onhatchet.run
#
# Local testing: `docker compose --profile workflows up -d` starts Hatchet
# Lite and the worker, and with the lines below Mako creates the tenant
# itself. WORKFLOWS_WORKER_KEY is the worker's Mako API key: any value of your
# own starting with `revops_`.
# HATCHET_API_URL=http://localhost:8086
# HATCHET_ADMIN_EMAIL=admin@example.com
# HATCHET_ADMIN_PASSWORD=Admin123!!
# HATCHET_DASHBOARD_URL=http://localhost:8086
# WORKFLOWS_WORKER_KEY=revops_replace_with_a_random_string

# Apps (git-backed apps — see apps.md). Always available; no feature flag.
# Required when the provider is "e2b".
E2B_API_KEY=
# E2B template for app sessions. Build the pnpm-preinstalled, cache-warmed
# template with `pnpm --filter api run apps:build-template` (alias
# mako-apps); falls back to E2B's stock "base" template when unset.
APPS_E2B_TEMPLATE=
# Storage roots (defaults under ~/.mako/apps/). Must be persistent volumes
# in production — the bare git repos are the durable source of truth.
APPS_GIT_ROOT=
APPS_SESSIONS_ROOT=
# §13.17/§17: the workspace's CONNECTED GitHub repo is the only durable store.
# Production sets APPS_REQUIRE_CONNECTED_REPO=true — no repo, no app/console
# saves — and pushes to the connected repo automatically. Previews/dev run on
# prod-cloned DBs that carry REAL customer bindings, so they treat bindings as
# inert metadata (local-only bare repos) unless this explicit opt-in is set
# (never sync it; use only with repos you own): APPS_CONNECTED_REPO_PUSH=allow

# Local development login shortcut (OFF unless set; NEVER set this in a
# deployed environment — the API refuses to boot if it is set alongside
# NODE_ENV=production).
#
# When set, this value works as the password for ANY local user on the normal
# login form, so you can stop typing a real password or bouncing through OAuth
# on every restart. Guarded four ways: non-production, loopback Host only,
# minimum 12 characters, and the boot-time refusal above. See
# api/src/auth/dev-login.ts.
#
#   curl -sc /tmp/mako.cookies -X POST localhost:8080/api/auth/login \
#     -H 'content-type: application/json' \
#     -d '{"email":"you@example.com","password":"'"$DEV_LOGIN_PASSWORD"'"}'
DEV_LOGIN_PASSWORD=

# Seed a local admin user (pnpm --filter api exec tsx src/scripts/seed-dev-admin.ts).
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=
